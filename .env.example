# ------------------------------------------------------------------
# Smart Water Consumption Analytics - environment configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# ------------------------------------------------------------------

# ---- Backend --------------------------------------------------------
# Postgres (recommended in docker): 
#   AQUA_DATABASE_URL=postgresql+psycopg2://aqua:aqua@localhost:5432/aqua
# Local quickstart (no DB server needed):
AQUA_DATABASE_URL=sqlite:///./smart_water.db
AQUA_CACHE_TTL_SECONDS=300
AQUA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Big data -------------------------------------------------------
# SPARK_MASTER=local[*]
# HADOOP_HOME=C:\hadoop          (Windows only; winutils.exe required)
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.x   (Windows only)

# ---- AquaAI -----------------------------------------------------------
# 'auto'  -> use an LLM when AQUA_LLM_API_KEY is set, else the built-in
#            deterministic, data-backed assistant
# 'local' -> always use the built-in assistant
# 'llm'   -> always require the LLM (fails hard if no key)
AQUA_AI_MODE=auto
# Provider: gemini | openai. "gemini" uses Google's OpenAI-compatible
# endpoint (https://generativelanguage.googleapis.com/v1beta/openai),
# so the same function-calling loop serves both.
AQUA_LLM_PROVIDER=gemini
AQUA_LLM_API_KEY=
# Leave blank to use the provider's default endpoint.
AQUA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AQUA_LLM_MODEL=gemini-2.5-flash
# Headroom for Gemini's internal reasoning tokens; keep it well above the
# longest expected answer or replies get cut off mid-sentence.
AQUA_LLM_MAX_TOKENS=4096
AQUA_ASSISTANT_NAME=AquaAI

# ---- Frontend (Vite) ---------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api

# ---- PostgreSQL (docker-compose) ----------------------------------------
POSTGRES_USER=aqua
POSTGRES_PASSWORD=ChangeMe123
POSTGRES_DB=aqua